mlruns/
mlartifacts/

# OS
.DS_Store
Thumbs.db

# Environment variables
.env

# Docker
*.log

# Model artifacts are tracked in MLflow, except the served model and its scores,
# which the hosted dashboard loads. Retrain and commit both together.
models/*.pkl
models/*.joblib
models/*_metrics.json
!models/rul_model.joblib
!models/rul_model_metrics.json
