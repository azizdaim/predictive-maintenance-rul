# Data: only the public NASA files the tests and hosted dashboard read are
# committed; download the rest with the README's Quick Start commands
/data/*
!/data/raw/
/data/raw/*
!/data/raw/test_FD001.txt
!/data/raw/RUL_FD001.txt
!/data/raw/train_FD001.txt
!/data/raw/test_FD002.txt
!/data/raw/test_FD003.txt

# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
*.egg

# Virtual environment
venv/
.venv/
env/

# IDE
.vscode/
.idea/
*.swp
*.swo

# Jupyter
.ipynb_checkpoints/
*.ipynb_metadata/

